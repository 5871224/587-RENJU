Options -Indexes

RewriteEngine On

# Public ranking/archive pages only accept the parameter shapes they actually use.
# This is defense in depth for legacy pages while their SQL is gradually modernized.
RewriteCond %{REQUEST_URI} ^/riftw/(rank|record)\.php$ [NC]
RewriteCond %{QUERY_STRING} (^|&)DATE= [NC]
RewriteCond %{QUERY_STRING} !(^|&)DATE=[0-9]{4}-[0-9]{2}-[0-9]{2}(&|$) [NC]
RewriteRule ^ - [R=400,L]

RewriteCond %{REQUEST_URI} ^/riftw/(tour|tourb)\.php$ [NC]
RewriteCond %{QUERY_STRING} (^|&)TOUR= [NC]
RewriteCond %{QUERY_STRING} !(^|&)TOUR=[1-9][0-9]*(&|$) [NC]
RewriteRule ^ - [R=400,L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
